# ---------------------------------------------------------------------------
# Azure Database for PostgreSQL (output database)
# ---------------------------------------------------------------------------
POSTGRES_HOST=ttb-public-pg.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=ttb-public-cola-registry
POSTGRES_SCHEMA=pcr-prod

# Authentication method: "password" or "entra"
POSTGRES_AUTH_METHOD=entra

# For POSTGRES_AUTH_METHOD=password: the Postgres login role and its password.
# For POSTGRES_AUTH_METHOD=entra: POSTGRES_USER is the Microsoft Entra principal
#   name (user UPN, group name, or managed identity name) that has been added as
#   an Entra administrator/role on the server. POSTGRES_PASSWORD is ignored and
#   an access token is acquired via DefaultAzureCredential (az login, managed
#   identity, service principal env vars, etc.).
#
# Local dev: your own Entra account (run `az login` first).
POSTGRES_USER="useremail_gmail.com#EXT#@useremailgmail.onmicrosoft.com"
# CI/CD (GitHub Actions, OIDC federated credential on app ttb-comments-pipeline):
#   POSTGRES_USER=ttb-comments-pipeline
POSTGRES_PASSWORD=

# TLS settings. "verify-full" (the default) validates the server certificate
# and hostname, protecting against man-in-the-middle attacks. Weaker modes such
# as "require" only encrypt and verify nothing - avoid them, especially with
# POSTGRES_AUTH_METHOD=entra, where the credential on the wire is a bearer token.
# POSTGRES_SSLROOTCERT defaults to the certifi CA bundle; override it only if
# your environment requires a different trust store.
POSTGRES_SSLMODE=verify-full
# POSTGRES_SSLROOTCERT=/path/to/ca-bundle.pem
POSTGRES_CONNECT_TIMEOUT=30

# ---------------------------------------------------------------------------
# Azure Blob Storage (private label images, streamed through the API)
# ---------------------------------------------------------------------------
BLOB_ACCOUNT_URL=https://ttbstoragetesting.blob.core.windows.net
BLOB_CONTAINER=ttb-public-cola-registry-images

# ---------------------------------------------------------------------------
# Image/text embedding provider (pluggable)
# ---------------------------------------------------------------------------
# gemini-embedding-2 is multimodal (text + image/video/audio/PDF) in one space.
# Output dim is flexible (128-3072; recommended 768/1536/3072); truncated dims
# are auto-normalized, so cosine similarity works without manual normalization.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Comma-separated allowed origins for CORS (use the SPA origin in production).
CORS_ORIGINS=*

# Path to the built Vite SPA (frontend/dist). When set and present, FastAPI
# serves the SPA at "/" (single-origin, no CORS needed). Leave unset for local
# dev where the Vite dev server proxies /api. The container sets this to
# /app/frontend/dist.
# SPA_DIR=frontend/dist