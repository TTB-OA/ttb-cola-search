# ---------------------------------------------------------------------------
# Azure Database for PostgreSQL (output database)
# ---------------------------------------------------------------------------
POSTGRES_HOST=ttb-public-pg.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=ttb-public-cola-registry
POSTGRES_SCHEMA=pcr-prod

# Authentication method: "password" or "entra"
POSTGRES_AUTH_METHOD=entra

# For POSTGRES_AUTH_METHOD=password: the Postgres login role and its password.
# For POSTGRES_AUTH_METHOD=entra: POSTGRES_USER is the Microsoft Entra principal
#   name (user UPN, group name, or managed identity name) that has been added as
#   an Entra administrator/role on the server. POSTGRES_PASSWORD is ignored and
#   an access token is acquired via DefaultAzureCredential (az login, managed
#   identity, service principal env vars, etc.).
#
# Local dev: your own Entra account (run `az login` first).
POSTGRES_USER="useremail_gmail.com#EXT#@useremailgmail.onmicrosoft.com"
# CI/CD (GitHub Actions, OIDC federated credential on app ttb-comments-pipeline):
#   POSTGRES_USER=ttb-comments-pipeline
POSTGRES_PASSWORD=

# TLS settings. "verify-full" (the default) validates the server certificate
# and hostname, protecting against man-in-the-middle attacks. Weaker modes such
# as "require" only encrypt and verify nothing - avoid them, especially with
# POSTGRES_AUTH_METHOD=entra, where the credential on the wire is a bearer token.
# POSTGRES_SSLROOTCERT defaults to the certifi CA bundle; override it only if
# your environment requires a different trust store.
POSTGRES_SSLMODE=verify-full
# POSTGRES_SSLROOTCERT=/path/to/ca-bundle.pem
POSTGRES_CONNECT_TIMEOUT=30

# ---------------------------------------------------------------------------
# Azure Blob Storage (private label images, streamed through the API)
# ---------------------------------------------------------------------------
BLOB_ACCOUNT_URL=https://ttbstoragetesting.blob.core.windows.net
BLOB_CONTAINER=ttb-public-cola-registry-images

# ---------------------------------------------------------------------------
# Image/text embedding provider (pluggable)
# ---------------------------------------------------------------------------
# gemini-embedding-2 is multimodal (text + image/video/audio/PDF) in one space.
# Output dim is flexible (128-3072; recommended 768/1536/3072); truncated dims
# are auto-normalized, so cosine similarity works without manual normalization.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Comma-separated allowed origins for CORS (use the SPA origin in production).
CORS_ORIGINS=*

# Path to the built Vite SPA (frontend/dist). When set and present, FastAPI
# serves the SPA at "/" (single-origin, no CORS needed). Leave unset for local
# dev where the Vite dev server proxies /api. The container sets this to
# /app/frontend/dist.
# SPA_DIR=frontend/dist

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Ceiling on any single statement, so a runaway query cannot pin a pool slot.
# Exceeding it returns HTTP 504.
POSTGRES_STATEMENT_TIMEOUT_MS=15000

# Image search reads the upload into memory before embedding it. Over the cap
# the request is rejected with HTTP 413.
MAX_UPLOAD_BYTES=10485760

# Image search calls a metered embedding API, so it is capped per client.
# The limiter is per replica, so the real ceiling is this times the replica
# count. Over the limit returns HTTP 429 with a Retry-After header.
IMAGE_SEARCH_RATE_LIMIT=10
IMAGE_SEARCH_RATE_WINDOW_SECONDS=60

# Whether to identify rate-limited clients by X-Forwarded-For. Only enable
# behind a reverse proxy that overwrites the header (Container Apps ingress
# does); otherwise clients can spoof it to reset their own bucket.
TRUST_FORWARDED_FOR=true

# ---------------------------------------------------------------------------
# Telemetry and analytics (Azure Monitor / Application Insights)
# ---------------------------------------------------------------------------
# Leave the connection string unset locally: telemetry then no-ops entirely and
# analytics events are only written to the application log. Bicep provisions the
# component and injects this as a secret in Azure.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# Master switch. Set false to disable tracing, metrics and log export even when
# a connection string is present.
TELEMETRY_ENABLED=true

# Fraction of requests sampled for distributed tracing, 0.0-1.0. Custom analytics
# events are not sampled; this only affects request/dependency traces. Lower it
# if ingestion cost becomes a concern at higher traffic.
TELEMETRY_SAMPLING_RATIO=1.0

# Whether to record the raw text of the `q` search box on search events. Off by
# default: free-text input is user-supplied content and may contain anything.
# Turn it on only with privacy sign-off; it enables top-query and zero-result
# query reporting.
ANALYTICS_CAPTURE_QUERY_TEXT=false

# Salt for the per-visitor session hash used when the SPA cannot supply its own
# session id. Rotating it makes previously emitted identifiers unlinkable, so
# treat it as a secret and rotate on a schedule.
ANALYTICS_SALT=

# --- Usage dashboard (/analytics) -------------------------------------------
# Off by default. The page is unlisted, not authenticated, and the API behind it
# returns 404 while this is false. Requires a "Log Analytics Reader" role
# assignment on the workspace for the app's managed identity; see the README.
ANALYTICS_DASHBOARD_ENABLED=false

# Log Analytics workspace GUID (the "customerId"), NOT the ARM resource id.
# Bicep injects this in Azure; set it by hand only for local development.
LOG_ANALYTICS_WORKSPACE_ID=

# Every cache miss is a billed Log Analytics query, and the numbers move slowly.
ANALYTICS_DASHBOARD_CACHE_SECONDS=900
ANALYTICS_DASHBOARD_RATE_LIMIT=30
ANALYTICS_DASHBOARD_RATE_WINDOW_SECONDS=60
