// PCR data model — TTB Public COLA Registry
//
// The DDL is one idempotent script, src/cola/core/pcr_baseline.py, applied by
// schema_migrate.py. This file documents that script for dbdiagram.io and
// should be updated whenever the baseline changes. The explicitly marked
// planned geolocation section is the design contract for work not yet added
// to the baseline or deployed.
//
// Column provenance:
//   [list]   CfmPublicRegistryMvDTO, GET /colas
//   [detail] ColaDTO, GET /colas/{id}
//   [scrape] ttbonline.gov HTML, not available from the API
//   [local]  written by the pipeline itself

Project pcr {
  database_type: 'PostgreSQL'
  Note: 'Schemas match pcr-<name>, e.g. pcr-dev, pcr-prod, pcr-test-devname.'
}

Table colas {
  cola_id              text        [pk, note: 'ttbId verbatim [list], COLLATE "C". Ids are not numeric: suffixes A/B/C/D/$ and embedded spaces occur, so the former bigint key stripped non-digits and leading zeros and collapsed distinct certificates onto one row']
  permit_num           varchar     [note: 'permitId [list]']
  serial_num           varchar     [note: 'serialNum [list]']
  brand_name           text        [note: 'brandName [list]']
  fanciful_name        text        [note: 'fancifulName [list]']
  origin_code          varchar     [note: 'originCode [list], label via ref_origins']
  class_type_code      varchar     [note: 'classTypeCode [list], label via ref_product_class_types']
  completed_date       date        [note: 'completedDate [list]']
  status_code          varchar     [note: 'statusCode [list], label via ref_status_types']
  status               varchar     [note: 'status [list]']
  received_code        varchar     [note: 'receivedCode [list], label via ref_received_codes']
  vendor_code          varchar     [note: 'vendorCode [detail]']
  for_sale_in          text        [note: 'forSaleIn [detail]']
  formula_num          varchar     [note: 'formulaNum [detail]']
  bottle_capacity      "numeric(12,4)" [note: 'bottleCapacity [detail], numeric upstream']
  image_count_to_parse integer     [note: 'images found by the image run [local]']
  scraped_on           timestamptz [note: 'last list-pass write [local]']
  detail_scraped_on    timestamptz [note: 'last detail-pass write [local]']
  source_of_product    varchar     [note: 'form item "SOURCE OF PRODUCT" [scraped]: Domestic | Imported']
  application_type     text        [note: 'form item "TYPE OF APPLICATION" [scraped], multi-select joined with " | "']
  exemption_state      varchar     [note: 'state abbreviation printed on the exemption option [scraped]']
  resubmission_ttb_id  text        [note: 'rejected TTB ID printed on the resubmission option [scraped], COLLATE "C"']
  type_of_product      varchar     [note: 'form item "TYPE OF PRODUCT" [scraped]: WINE | DISTILLED SPIRITS | MALT BEVERAGE']
  application_date     date        [note: 'form item "DATE OF APPLICATION" [scraped]']
  issued_date          date        [note: 'form item "DATE ISSUED" [scraped], blank until the certificate issues']
  expiration_date      date        [note: '"EXPIRATION DATE (If any)" from the certificate status block [scraped], set only where status is Expired']

  indexes {
    completed_date
    detail_scraped_on
  }
}

Table cola_images {
  cola_id         text        [note: 'FK to colas']
  file_name       varchar     [note: 'blob basename, or __no_images__ sentinel']
  img_type        varchar
  width_px        integer
  height_px       integer
  dimensions_txt  varchar
  blob_name       text
  blob_url        text
  download_status varchar     [note: 'SUCCESS, NONE and UNAVAILABLE are terminal. NONE means TTB said there is no label; UNAVAILABLE means its detail page could not be read, so the answer is unknown.']
  scraped_on      timestamptz

  // Written only by code/image_embedding.py. pgvector, 768 dimensions to match
  // gemini-embedding-2; the image and text vectors share one space.
  image_feature_vector       "vector(768)" [note: 'embedding of the label image [local]']
  image_feature_vector_date  timestamptz
  image_feature_vector_model varchar
  text_feature_vector        "vector(768)" [note: 'embedding of the OCR text [local]']
  text_feature_vector_date   timestamptz
  text_feature_vector_model  varchar

  indexes {
    (cola_id, file_name) [pk]
    download_status
    image_feature_vector_model
    image_feature_vector [type: hnsw, note: 'cosine ANN']
    text_feature_vector [type: hnsw, note: 'cosine ANN']
  }
}

// -----------------------------------------------------------------------------
// Image enrichment, written by code/image_analysis.py
// -----------------------------------------------------------------------------

// One row per image per analysis model: the run header, so a model can be
// swapped or re-run without disturbing another model's results.
Table cola_image_analysis {
  cola_id              text        [note: 'FK to colas']
  file_name            varchar     [note: 'FK to cola_images']
  analysis_model       varchar     [note: 'e.g. prebuilt-read']
  model_version        varchar     [note: 'service API version that answered']
  analysis_status      varchar     [note: 'SUCCESS or NONE are terminal']
  analysis_completed_on timestamptz
  metadata             jsonb       [note: 'page count, languages, content length']

  indexes {
    (cola_id, file_name, analysis_model) [pk]
    analysis_status
    cola_id
  }
}

// The recognised text itself, one row per line, word or paragraph.
Table image_analysis_items {
  id                bigint  [pk, increment]
  cola_id           text    [note: 'FK to colas']
  file_name         varchar
  analysis_model    varchar
  analysis_item_type varchar [note: 'line | word | paragraph']
  text              text
  model_confidence  real
  bounding_box      jsonb   [note: 'page, unit and polygon as returned']

  indexes {
    (cola_id, file_name, analysis_model)
    analysis_item_type
  }
}

// One row per billable API unit, written by image analysis, embedding, and
// Azure Maps geolocation. usage_summary.py rolls these up by month and prices
// them. A provider populates only the measures it reports, so the count columns
// are nullable except record_count.
Table api_usage {
  id            bigint      [pk, increment]
  component     varchar     [note: 'image_analysis | image_embedding | geolocation']
  provider      varchar     [note: 'azure_document_intelligence | google_gemini | azure_maps']
  model         varchar     [note: 'model name or provider API version']
  operation     varchar     [note: 'ocr | image_embedding | text_embedding | geocoding']
  cola_id       text        [note: 'FK to colas, nullable']
  file_name     varchar     [note: 'image the unit was billed for']
  business_date date        [note: 'day being processed, for reference']
  run_name      varchar
  record_count  integer     [note: 'billable records/calls, defaults 1']
  page_count    integer     [note: 'Document Intelligence pages']
  token_count   bigint      [note: 'embedding input tokens']
  char_count    bigint      [note: 'embedding billable characters']
  recorded_on   timestamptz [note: 'when the cost was incurred; groups the summary']

  indexes {
    recorded_on
    (provider, model, operation, recorded_on)
    business_date
  }
}

Table cola_permits {
  cola_id                text    [note: 'FK to colas']
  permit_id              varchar [note: 'permits[].permitId [detail]']
  primary_permit_flg     boolean [note: 'permits[].primaryPermitFlg [detail]']
  permit_name            text
  permit_frst_strt_addr  text
  permit_secnd_strt_addr text
  permit_city_addr       varchar
  permit_state_addr      varchar
  permit_zip_addr        varchar
  permit_zip4_addr       varchar
  permit_cntry_addr      varchar

  indexes {
    (cola_id, permit_id) [pk]
    permit_id
  }
}

Table cola_submitters {
  cola_id          text    [pk, note: 'FK to colas']
  submitter_id     varchar [note: 'submitter.submitterId [detail]']
  submtr_frst_name text
  submtr_last_name text
  tel_no           varchar
  fax_no           varchar
}

Table cola_qualifications {
  cola_id                   text    [note: 'FK to colas']
  ref_qualification_id      integer [note: 'qualificationRef.refQualificationId [detail]']
  appln_qualftn_id          bigint  [note: 'applnQualftnId [detail]']
  qualification_text        text    [note: 'qualificationRef.longDesc [detail]']
  qualification_comment_text text   [note: 'qualftnCommentText, per-application [detail]']

  indexes {
    (cola_id, ref_qualification_id) [pk]
  }
}

Table cola_grape_varietals {
  cola_id    text    [note: 'FK to colas']
  vartl_id   integer [note: 'grapeVarietals[].vartlId [detail]']
  vartl_name text    [note: 'grapeVarietals[].vartlName [detail]']

  indexes {
    (cola_id, vartl_id) [pk]
  }
}

// -----------------------------------------------------------------------------
// Reference tables, refreshed by code/sync_reference_data.py
// -----------------------------------------------------------------------------

Table ref_status_types {
  status_code      varchar [pk, note: 'GET /status-types']
  final_status_flg boolean
  synced_on        timestamptz
}

Table ref_product_class_types {
  class_type_code varchar [pk, note: 'GET /product-class-types']
  description     text
  synced_on       timestamptz
}

Table ref_origins {
  origin_code varchar [pk, note: 'GET /origins']
  description text
  synced_on   timestamptz
}

Table ref_grape_varietals {
  vartl_id   integer [pk, note: 'GET /grape-varietals']
  vartl_name text
  synced_on  timestamptz
}

Table ref_qualifications {
  ref_qualification_id integer [pk, note: 'GET /qualifications']
  long_desc            text
  synced_on            timestamptz
}

// receivedCode has no upstream endpoint; seeded from REF_RECEIVED_CODES_SEED.
Table ref_received_codes {
  received_code varchar [pk]
  description   text
}

// -----------------------------------------------------------------------------
// Pipeline state
// -----------------------------------------------------------------------------

Table pipeline_day_status {
  component     varchar     [note: 'list_ingest | detail_fill | image_ingest | image_analysis | image_embedding']
  business_date date
  status        varchar     [note: 'pending | in_progress | complete | gave_up']
  api_count     integer     [note: 'expected, from /colas/count or local colas']
  db_count      integer     [note: 'actual, measured after the run']
  attempt_count integer
  last_run_name varchar
  last_run_on   timestamptz [note: 'when this component last touched the day']
  counts_stable_since timestamptz [note: 'when api_count was last seen to change; the settling window is measured from here, and reopening a day clears it [local]']
  last_error    text

  indexes {
    (component, business_date) [pk]
    (component, status, business_date)
  }

  Note: 'The pipeline\'s only position marker. A day is complete only when api_count equals db_count.'
}

Table schema_migrations {
  migration_id varchar(120) [pk]
  checksum     char(64)     [note: 'sha-256 hex digest of the migration text']
  applied_on   timestamptz
  applied_by   varchar(120)
}

// -----------------------------------------------------------------------------
// GEOLOCATION PROVENANCE DEPLOYED; MAP SEARCH PLANNED
//
// The provenance, selection, and dirty-queue tables are deployed in pcr-prod.
// cola_map_search remains planned for the map-materialization phase.
//
// Location roles:
//   permit_premise   every permit address observed on a COLA
//   primary_premise  primary permit address; a subset of permit_premise for
//                    both domestic and imported COLAs
//   product_origin   curated origin-code centroid for every COLA: U.S. state
//                    for domestic products and country for imported products
//
// Targets are reusable cache identities. Observations preserve per-COLA source
// semantics, results are append-only provider attempts, and selections identify
// the current result without mutating provider history.
// -----------------------------------------------------------------------------

// Versioned local spatial enrichment for the TTB-owned origin vocabulary.
// ref_origins remains authoritative for code descriptions; this table adds only
// geographic interpretation and dataset provenance. A run selects one dataset
// version and writes its chosen row as a curated_origin provider result.
Table ref_origin_locations {
  origin_code        varchar     [not null, note: 'logical FK to ref_origins; description is joined from there']
  dataset_version    varchar     [not null]
  geography_level    varchar     [not null, note: 'us_state | country']
  iso_country_code   char(2)
  subdivision_code   varchar     [note: 'ISO 3166-2 or equivalent for domestic state origins']
  location           "geography(POINT,4326)" [not null, note: 'representative centroid; requires PostGIS']
  latitude           double      [not null]
  longitude          double      [not null]
  source_name        varchar     [not null]
  source_url         text
  source_license     text
  source_date        date
  loaded_on          timestamptz [not null]

  indexes {
    (origin_code, dataset_version) [pk]
    (dataset_version, geography_level)
    location [type: gist]
  }
}

Table geolocation_run {
  run_id                 bigint      [pk, increment]
  run_name               varchar     [not null]
  component              varchar     [not null, note: 'geolocation; advisory-locked, not day-ledger managed']
  status                 varchar     [not null, note: 'running | complete | failed | stopped']
  provider_chain         jsonb       [not null, note: 'ordered providers and versions used by this run']
  provider_config        jsonb       [note: 'non-secret limits, retry policy, and paid fallback settings']
  normalizer_version     varchar     [not null]
  selection_rule_version varchar     [not null]
  target_count           integer
  result_count           integer
  selected_count         integer
  fallback_count         integer
  billable_transactions  integer
  estimated_cost_usd     numeric
  started_on             timestamptz [not null]
  completed_on           timestamptz
  terminal_error         text

  indexes {
    (status, started_on)
    run_name [unique]
  }
}

Table geolocation_target {
  target_kind        varchar     [not null, note: 'permit_address | product_origin']
  normalizer_version varchar     [not null, note: 'identity changes when normalization semantics change']
  target_key         char(64)    [not null, note: 'SHA-256 of target kind, normalizer version, and canonical input']
  origin_code        varchar     [note: 'product_origin only; joins authoritative details from ref_origins']
  canonical_input    jsonb       [not null, note: 'provider-neutral structured address or origin value']
  display_text       text        [not null]
  validity_status    varchar     [not null, note: 'valid | invalid']
  created_on         timestamptz [not null]
  last_seen_on       timestamptz [not null]

  indexes {
    (target_kind, normalizer_version, target_key) [pk]
    (target_kind, validity_status, last_seen_on)
  }
}

Table geolocation_observation {
  cola_id            text        [not null, note: 'historical per-COLA source observation']
  location_role      varchar     [not null, note: 'permit_premise | primary_premise | product_origin']
  source_key         varchar     [not null, note: 'permit_id or origin_code']
  target_kind        varchar     [not null]
  normalizer_version varchar     [not null]
  target_key         char(64)    [not null]
  primary_permit_flg boolean
  observed_on        timestamptz [not null]

  indexes {
    (cola_id, location_role, source_key) [pk]
    (target_kind, normalizer_version, target_key)
  }
}

Table geolocation_result {
  result_id             bigint      [pk, increment]
  run_id                bigint      [not null]
  target_kind           varchar     [not null]
  normalizer_version    varchar     [not null]
  target_key            char(64)    [not null]
  provider              varchar     [not null, note: 'census | curated_origin | azure_maps']
  provider_version      varchar
  status                varchar     [not null, note: 'matched | unmatched | ambiguous | invalid | error']
  location              "geography(POINT,4326)" [note: 'WGS84; requires PostGIS']
  latitude              double
  longitude             double
  matched_address       text
  native_confidence     varchar     [note: 'provider-native value retained verbatim; never synthesized']
  native_match_codes    jsonb
  calculation_method    varchar     [note: 'Rooftop | Parcel | Interpolation | centroid, provider-native where available']
  quality_class         varchar     [note: 'rooftop | parcel | interpolated | centroid | up_hierarchy | ambiguous | unmatched | invalid']
  quality_rule_version  varchar     [not null]
  response_metadata     jsonb
  requested_on          timestamptz [not null]
  completed_on          timestamptz
  retry_count           integer     [not null, default: 0]
  error_code            varchar
  error_message         text
  billable_transactions integer     [not null, default: 0]

  indexes {
    (target_kind, normalizer_version, target_key, provider, completed_on)
    run_id
    location [type: gist]
  }
}

Table geolocation_selection {
  target_kind            varchar     [not null]
  normalizer_version     varchar     [not null]
  target_key             char(64)    [not null]
  result_id              bigint      [not null, unique]
  selection_rule_version varchar     [not null]
  selected_on            timestamptz [not null]

  indexes {
    (target_kind, normalizer_version, target_key) [pk]
  }
}

Table geolocation_dirty {
  target_kind        varchar     [not null]
  normalizer_version varchar     [not null]
  target_key         char(64)    [not null]
  marked_at          timestamptz [not null]

  indexes {
    (target_kind, normalizer_version, target_key) [pk]
    (marked_at, target_kind, target_key)
  }
}

Table geolocation_source_dirty {
  cola_id   text        [pk, note: 'COLA whose current permits/origin must be normalized and reconciled']
  marked_at timestamptz [not null]

  indexes {
    (marked_at, cola_id)
  }

  Note: 'COLA-keyed because a new or deleted source has no normalized target key yet. The geolocation CLI claims one row at a time with FOR UPDATE SKIP LOCKED.'
}

Table cola_map_dirty {
  cola_id   text        [pk]
  marked_at timestamptz [not null]

  indexes {
    (marked_at, cola_id)
  }
}

Table cola_map_search {
  cola_id              text        [not null]
  location_role        varchar     [not null]
  source_key           varchar     [not null]
  target_kind          varchar     [not null]
  normalizer_version   varchar     [not null]
  target_key           char(64)    [not null]
  result_id            bigint      [not null]
  location             "geography(POINT,4326)" [not null, note: 'indexed source of truth for viewport and distance queries']
  latitude             double      [not null]
  longitude            double      [not null]
  geolocation_provider varchar     [not null]
  geolocation_quality  varchar     [not null]
  geolocation_method   varchar
  ct_commodity         text
  ct_source            text
  class_type_code      varchar
  class_type           text
  origin_code          varchar
  origin               text
  grape_varietal       text        [note: 'PLANNED. Denormalized join of cola_grape_varietals.vartl_name, matching cola_search.grape_varietal. The map filters it with ILIKE; until it exists the API reports varietalAvailable=false and rejects the filter with 400.']
  completed_date       date
  application_date     date
  permit_id            varchar
  permit_name          text
  best_image_file_name varchar
  best_image_blob_url  text
  best_image_score     numeric
  _loaded_at           timestamptz [not null]

  indexes {
    (cola_id, location_role, source_key) [pk]
    location [type: gist]
    (location_role, completed_date)
    (ct_commodity, completed_date)
    (ct_source, completed_date)
    (class_type_code, completed_date)
    (origin_code, completed_date)
    (geolocation_quality, completed_date)
    grape_varietal [type: gin, note: 'PLANNED, gin_trgm_ops: the varietal filter is a substring match.']
  }
}

// Asynchronous Gemini batch embedding jobs, written by image_embedding.py.
// A job outlives the CI cycle that created it, so the in-flight work has to be
// tracked in the database rather than in process memory.
Table embedding_batch_job {
  job_id            bigint  [pk, increment]
  component         varchar [note: 'always image_embedding today']
  business_date     date
  provider          varchar
  provider_job_name text    [note: 'batches/... ; NULL until create_embeddings returns']
  display_name      varchar [note: 'assigned before submission, so an orphaned job is findable']
  input_file_name   text    [note: 'uploaded JSONL, deleted after collection']
  result_file_name  text
  model             varchar
  dimension         integer [note: '768']
  state             varchar [note: 'submitted | running | succeeded | failed | expired | cancelled | collected']
  request_count       integer
  image_request_count integer
  text_request_count  integer
  succeeded_count     integer
  failed_count        integer
  request_bytes     bigint
  attempt           integer
  run_name          varchar
  last_error        text
  submitted_on      timestamptz
  last_polled_on    timestamptz
  completed_on      timestamptz
  collected_on      timestamptz

  indexes {
    provider_job_name [unique, note: 'partial: WHERE provider_job_name IS NOT NULL']
    display_name [unique]
    (component, state, submitted_on)
    (component, business_date)
  }

  Note: 'Creating a batch is not idempotent, so this table is the guard against re-billing images already in flight.'
}

// One request line inside a job. The provider echoes only item_key back on each
// result line, and file_name is untrusted free text that would break any scheme
// encoding the identity into that key, so the mapping is stored instead.
Table embedding_batch_item {
  job_id      bigint
  item_key    varchar
  cola_id     text
  file_name   varchar
  modality    varchar [note: 'image | text']
  state       varchar [note: 'pending | written | failed']
  token_count integer [note: 'promptTokenCount from the batch result']
  last_error  text

  indexes {
    (job_id, item_key) [pk]
    (cola_id, file_name) [note: 'drives the in-flight exclusion on the next submit']
  }
}

// Materialised search surface, one row per COLA, maintained from vw_colas by
// search_materialize.py. ocr_text lives in cola_search_ocr so label text never
// bloats the hot row. Only the added/managed columns are listed; the rest mirror
// vw_colas one-for-one.
Table cola_search {
  cola_id                   text        [pk, note: 'from vw_colas [local]']
  completed_date            date        [note: 'mirrors colas.completed_date']
  brand_name                text        [note: 'mirrors colas.brand_name']
  fanciful_name             text        [note: 'mirrors colas.fanciful_name']
  applicant_name            text        [note: 'permit or submitter name [local]']
  ct_commodity              text        [note: 'wine | beer | distilled_spirits | unknown — from type_of_product, else class_type_code [local]']
  ct_source                 text        [note: 'domestic | import | unknown [local]']
  origin                    text        [note: 'mirrors colas origin label']
  status                    varchar     [note: 'mirrors colas.status']
  primary_permit_state_addr varchar     [note: 'primary permit state, indexed upper() [local]']
  serial_num                varchar     [note: 'id-ish, exact/prefix btree [local]']
  permit_num                varchar     [note: 'id-ish, exact/prefix btree [local]']
  primary_permit_id         varchar     [note: 'id-ish, exact/prefix btree [local]']
  submitter_id              varchar     [note: 'id-ish, exact/prefix btree [local]']
  permits                   jsonb       [note: 'rolled-up permits array [local]']
  search_tsv                tsvector    [note: 'generated: A brand/fanciful, B applicant/permit, C rest; GIN, websearch_to_tsquery [local]']
  _loaded_at                timestamptz [note: 'as-of time this row was materialised [local]']

  indexes {
    (completed_date, cola_id)                                     [note: 'DESC NULLS LAST, matches newest-first sort']
    (ct_commodity, completed_date, cola_id)                       [note: 'facet + newest-first']
    (ct_source, completed_date, cola_id)                          [note: 'facet + newest-first']
    (status, completed_date, cola_id)                             [note: 'facet + newest-first']
    (origin, completed_date, cola_id)                             [note: 'facet + newest-first']
    (brand_name, cola_id)
    (applicant_name, cola_id)
    `upper(primary_permit_state_addr)`
    serial_num [note: 'varchar_pattern_ops']
    permit_num [note: 'varchar_pattern_ops']
    primary_permit_id [note: 'varchar_pattern_ops']
    submitter_id [note: 'varchar_pattern_ops']
    brand_name [type: gin, note: 'pg_trgm']
    fanciful_name [type: gin, note: 'pg_trgm']
    applicant_name [type: gin, note: 'pg_trgm']
    permits [type: gin, note: 'jsonb_path_ops']
    search_tsv [type: gin]
  }

  Note: 'Physical copy of vw_colas for indexing. Only the pk, indexed and managed columns are listed; the rest mirror vw_colas one-for-one. Never written by hand.'
}

Table cola_search_ocr {
  cola_id    text        [pk]
  ocr_text   text        [note: 'concatenated label OCR [local]']
  ocr_tsv    tsvector    [note: 'generated tsvector over ocr_text, GIN [local]']
  _loaded_at timestamptz [note: 'as-of time this row was materialised [local]']

  indexes {
    ocr_tsv [type: gin]
  }
}

// Refresh queue for cola_search. AFTER-row triggers on colas and its child
// tables push changed cola_ids here; search_materialize.py drains it so the
// nightly job touches only what moved, regardless of which table changed.
Table cola_search_dirty {
  cola_id   text        [pk, note: 'COLA awaiting (re)materialisation [local]']
  marked_at timestamptz [note: 'when it was queued; drained oldest-first [local]']

  indexes {
    (marked_at, cola_id)
  }
}

// Pipeline coverage by calendar year of colas.completed_date, rebuilt whole by
// search_materialize.py on every run. A COLA counts towards an enrichment stage
// only when every one of its stored images (SUCCESS with a blob) is done.
Table cola_coverage_year {
  coverage_year        integer     [pk, note: 'calendar year of completed_date [local]']
  api_cola_count       bigint      [note: 'sum of pipeline_day_status.api_count for list_ingest; upstream truth, nullable [local]']
  ingested_cola_count  bigint      [note: 'colas rows [local]']
  detail_cola_count    bigint      [note: 'colas with detail_scraped_on [local]']
  image_cola_count     bigint      [note: 'colas with >= 1 stored image [local]']
  ocr_cola_count       bigint      [note: 'colas whose every stored image has a terminal analysis [local]']
  embedding_cola_count bigint      [note: 'colas whose every stored image has an image_feature_vector [local]']
  origin_geocoded_cola_count bigint [note: 'COLAs with a selected spatial product_origin observation [local]']
  permit_geocoded_cola_count bigint [note: 'COLAs with any selected spatial permit_premise observation [local]']
  primary_permit_geocoded_cola_count bigint [note: 'COLAs with a selected spatial primary_premise observation [local]']
  _loaded_at           timestamptz [note: 'as-of time this row was materialised [local]']
}

// One row per permit_id, rebuilt whole by search_materialize.py on every run.
// cola_permits only holds detail-filled COLAs, so cola_count is rolled up from
// cola_permits UNION colas.permit_num for COLAs cola_permits hasn't reached yet,
// keeping it the true count rather than the detail-filled subset. A permit's
// display fields (permit_name, addresses) come only from cola_permits, so they
// stay null until at least one of its COLAs is detail-filled.
Table cola_permit_search {
  permit_id              varchar     [pk, note: 'as scraped, already uppercase [local]']
  permit_name            text        [note: 'latest by completed_date, for display [local]']
  name_variants          text[]      [note: 'every distinct name seen, for recall [local]']
  names_blob             text        [note: 'name_variants joined with " | ", trigram-indexed [local]']
  permit_frst_strt_addr  text        [note: '[local]']
  permit_secnd_strt_addr text        [note: '[local]']
  permit_city_addr       varchar     [note: '[local]']
  permit_state_addr      varchar     [note: '[local]']
  permit_zip_addr        varchar     [note: '[local]']
  permit_zip4_addr       varchar     [note: '[local]']
  permit_cntry_addr      varchar     [note: '[local]']
  cola_count             bigint      [note: 'distinct COLAs on this permit, list+detail sourced [local]']
  primary_cola_count     bigint      [note: 'of cola_count, where this was the primary permit [local]']
  first_completed_date   date        [note: '[local]']
  last_completed_date    date        [note: '[local]']
  _loaded_at             timestamptz [note: 'as-of time this row was materialised [local]']

  indexes {
    (permit_id) [name: 'cola_permit_search_permit_id_pattern_idx']
    names_blob [type: gin, name: 'cola_permit_search_names_trgm_idx']
    (cola_count, permit_id) [name: 'cola_permit_search_cola_count_idx']
  }
}

// -----------------------------------------------------------------------------
// Views (defined in pcr_baseline.py, not drawn here)
//
//   vw_colas         one wide row per COLA: colas joined to its reference
//                    labels, submitter, primary permit, and rolled-up permits,
//                    qualifications, grape varietals, images and analyses.
//                    cola_search is a materialised copy of it.
//   v_colas_labeled  the list-pass columns with reference codes resolved to
//                    descriptions; the readable view for ad-hoc queries.
//
// Both are recreated wholesale by the baseline, so they carry no independent
// model and are omitted rather than duplicated.
// -----------------------------------------------------------------------------

// The references below are logical, not physical: no FOREIGN KEY constraints
// exist in the database. Days arrive out of order and child rows are written
// by separate pipeline stages, so enforcing them would reject valid partial
// state. They are drawn to show intent.
Ref: cola_images.cola_id > colas.cola_id
Ref: cola_image_analysis.(cola_id, file_name) > cola_images.(cola_id, file_name)
Ref: image_analysis_items.(cola_id, file_name, analysis_model) > cola_image_analysis.(cola_id, file_name, analysis_model)
Ref: api_usage.cola_id > colas.cola_id
Ref: cola_permits.cola_id > colas.cola_id
Ref: cola_submitters.cola_id - colas.cola_id
Ref: cola_qualifications.cola_id > colas.cola_id
Ref: cola_grape_varietals.cola_id > colas.cola_id
Ref: cola_search.cola_id - colas.cola_id
Ref: cola_search_ocr.cola_id - cola_search.cola_id
Ref: cola_search_dirty.cola_id > colas.cola_id
Ref: cola_permit_search.permit_id - cola_permits.permit_id
Ref: embedding_batch_item.job_id > embedding_batch_job.job_id
Ref: embedding_batch_item.(cola_id, file_name) > cola_images.(cola_id, file_name)

// Physical geolocation foreign keys.
Ref: ref_origin_locations.origin_code > ref_origins.origin_code
Ref: geolocation_observation.(target_kind, normalizer_version, target_key) > geolocation_target.(target_kind, normalizer_version, target_key)
Ref: geolocation_result.run_id > geolocation_run.run_id
Ref: geolocation_result.(target_kind, normalizer_version, target_key) > geolocation_target.(target_kind, normalizer_version, target_key)
Ref: geolocation_selection.(target_kind, normalizer_version, target_key) - geolocation_target.(target_kind, normalizer_version, target_key)
Ref: geolocation_selection.result_id - geolocation_result.result_id
Ref: geolocation_dirty.(target_kind, normalizer_version, target_key) - geolocation_target.(target_kind, normalizer_version, target_key)

// Logical geolocation relationships. COLA source/observation links are not
// enforced so partial pipeline state remains valid; cola_map_search is planned.
Ref: geolocation_target.origin_code > ref_origins.origin_code
Ref: geolocation_observation.cola_id > colas.cola_id
Ref: geolocation_source_dirty.cola_id > colas.cola_id
Ref: cola_map_dirty.cola_id > colas.cola_id
Ref: cola_map_search.cola_id > colas.cola_id
Ref: cola_map_search.result_id > geolocation_result.result_id

Ref: colas.status_code > ref_status_types.status_code
Ref: colas.class_type_code > ref_product_class_types.class_type_code
Ref: colas.origin_code > ref_origins.origin_code
Ref: colas.received_code > ref_received_codes.received_code
Ref: cola_grape_varietals.vartl_id > ref_grape_varietals.vartl_id
Ref: cola_qualifications.ref_qualification_id > ref_qualifications.ref_qualification_id
