// PCR data model — TTB Public COLA Registry
//
// Source of truth is code/pcr_schema.py (PCR_MIGRATIONS). This file documents
// that model for dbdiagram.io and should be updated whenever a migration is
// added.
//
// Column provenance:
//   [list]   CfmPublicRegistryMvDTO, GET /colas
//   [detail] ColaDTO, GET /colas/{id}
//   [scrape] ttbonline.gov HTML, not available from the API
//   [local]  written by the pipeline itself

Project pcr {
  database_type: 'PostgreSQL'
  Note: 'Schemas match pcr-<name>, e.g. pcr-dev, pcr-prod, pcr-test-devname.'
}

Table colas {
  cola_id              bigint      [pk, note: 'ttbId [list]']
  permit_num           varchar     [note: 'permitId [list]']
  serial_num           varchar     [note: 'serialNum [list]']
  brand_name           varchar     [note: 'brandName [list]']
  fanciful_name        varchar     [note: 'fancifulName [list]']
  origin_code          varchar     [note: 'originCode [list], label via ref_origins']
  class_type_code      varchar     [note: 'classTypeCode [list], label via ref_product_class_types']
  completed_date       date        [note: 'completedDate [list]']
  status_code          varchar     [note: 'statusCode [list], label via ref_status_types']
  status               varchar     [note: 'status [list]']
  received_code        varchar     [note: 'receivedCode [list], label via ref_received_codes']
  vendor_code          varchar     [note: 'vendorCode [detail]']
  for_sale_in          text        [note: 'forSaleIn [detail]']
  formula_num          varchar     [note: 'formulaNum [detail]']
  bottle_capacity      "numeric(12,4)" [note: 'bottleCapacity [detail], numeric upstream']
  image_count_to_parse integer     [note: 'images found by the image run [local]']
  scraped_on           timestamptz [note: 'last list-pass write [local]']
  detail_scraped_on    timestamptz [note: 'last detail-pass write [local]']
  source_of_product    varchar     [note: 'form item "SOURCE OF PRODUCT" [scraped]: Domestic | Imported']
  application_type     text        [note: 'form item "TYPE OF APPLICATION" [scraped], multi-select joined with " | "']
  exemption_state      varchar     [note: 'state abbreviation printed on the exemption option [scraped]']
  resubmission_ttb_id  bigint      [note: 'rejected TTB ID printed on the resubmission option [scraped]']

  indexes {
    completed_date
    detail_scraped_on
  }
}

Table cola_images {
  cola_id         bigint      [note: 'FK to colas']
  file_name       varchar     [note: 'blob basename, or __no_images__ sentinel']
  img_type        varchar
  width_px        integer
  height_px       integer
  dimensions_txt  varchar
  blob_name       varchar
  blob_url        text
  download_status varchar     [note: 'SUCCESS or NONE are terminal']
  scraped_on      timestamptz

  // Written only by code/image_embedding.py. pgvector, 768 dimensions to match
  // gemini-embedding-2; the image and text vectors share one space.
  image_feature_vector       "vector(768)" [note: 'embedding of the label image [local]']
  image_feature_vector_date  timestamptz
  image_feature_vector_model varchar
  text_feature_vector        "vector(768)" [note: 'embedding of the OCR text [local]']
  text_feature_vector_date   timestamptz
  text_feature_vector_model  varchar

  indexes {
    (cola_id, file_name) [pk]
    download_status
    image_feature_vector_model
    image_feature_vector [type: hnsw, note: 'cosine ANN']
    text_feature_vector [type: hnsw, note: 'cosine ANN']
  }
}

// -----------------------------------------------------------------------------
// Image enrichment, written by code/image_analysis.py
// -----------------------------------------------------------------------------

// One row per image per analysis model: the run header, so a model can be
// swapped or re-run without disturbing another model's results.
Table cola_image_analysis {
  cola_id              bigint      [note: 'FK to colas']
  file_name            varchar     [note: 'FK to cola_images']
  analysis_model       varchar     [note: 'e.g. prebuilt-read']
  model_version        varchar     [note: 'service API version that answered']
  analysis_status      varchar     [note: 'SUCCESS or NONE are terminal']
  analysis_completed_on timestamptz
  metadata             jsonb       [note: 'page count, languages, content length']

  indexes {
    (cola_id, file_name, analysis_model) [pk]
    analysis_status
    cola_id
  }
}

// The recognised text itself, one row per line, word or paragraph.
Table image_analysis_items {
  id                bigint  [pk, increment]
  cola_id           bigint  [note: 'FK to colas']
  file_name         varchar
  analysis_model    varchar
  analysis_item_type varchar [note: 'line | word | paragraph']
  text              text
  model_confidence  real
  bounding_box      jsonb   [note: 'page, unit and polygon as returned']

  indexes {
    (cola_id, file_name, analysis_model)
    analysis_item_type
  }
}

// One row per billable API unit, written by code/image_analysis.py (OCR pages)
// and code/image_embedding.py (embedding calls). code/usage_summary.py rolls
// these up by month and prices them. A provider populates only the measures it
// reports, so the count columns are nullable except record_count.
Table api_usage {
  id            bigint      [pk, increment]
  component     varchar     [note: 'image_analysis | image_embedding']
  provider      varchar     [note: 'azure_document_intelligence | google_gemini']
  model         varchar     [note: 'e.g. prebuilt-read, gemini-embedding-2']
  operation     varchar     [note: 'ocr | image_embedding | text_embedding']
  cola_id       bigint      [note: 'FK to colas, nullable']
  file_name     varchar     [note: 'image the unit was billed for']
  business_date date        [note: 'day being processed, for reference']
  run_name      varchar
  record_count  integer     [note: 'billable records/calls, defaults 1']
  page_count    integer     [note: 'Document Intelligence pages']
  token_count   bigint      [note: 'embedding input tokens']
  char_count    bigint      [note: 'embedding billable characters']
  recorded_on   timestamptz [note: 'when the cost was incurred; groups the summary']

  indexes {
    recorded_on
    (provider, model, operation, recorded_on)
    business_date
  }
}

Table cola_permits {
  cola_id                bigint  [note: 'FK to colas']
  permit_id              varchar [note: 'permits[].permitId [detail]']
  primary_permit_flg     boolean [note: 'permits[].primaryPermitFlg [detail]']
  permit_name            varchar
  permit_frst_strt_addr  varchar
  permit_secnd_strt_addr varchar
  permit_city_addr       varchar
  permit_state_addr      varchar
  permit_zip_addr        varchar
  permit_zip4_addr       varchar
  permit_cntry_addr      varchar

  indexes {
    (cola_id, permit_id) [pk]
    permit_id
  }
}

Table cola_submitters {
  cola_id          bigint  [pk, note: 'FK to colas']
  submitter_id     varchar [note: 'submitter.submitterId [detail]']
  submtr_frst_name varchar
  submtr_last_name varchar
  tel_no           varchar
  fax_no           varchar
}

Table cola_qualifications {
  cola_id                   bigint  [note: 'FK to colas']
  ref_qualification_id      integer [note: 'qualificationRef.refQualificationId [detail]']
  appln_qualftn_id          bigint  [note: 'applnQualftnId [detail]']
  qualification_text        text    [note: 'qualificationRef.longDesc [detail]']
  qualification_comment_text text   [note: 'qualftnCommentText, per-application [detail]']

  indexes {
    (cola_id, ref_qualification_id) [pk]
  }
}

Table cola_grape_varietals {
  cola_id    bigint  [note: 'FK to colas']
  vartl_id   integer [note: 'grapeVarietals[].vartlId [detail]']
  vartl_name varchar [note: 'grapeVarietals[].vartlName [detail]']

  indexes {
    (cola_id, vartl_id) [pk]
  }
}

// -----------------------------------------------------------------------------
// Reference tables, refreshed by code/sync_reference_data.py
// -----------------------------------------------------------------------------

Table ref_status_types {
  status_code      varchar [pk, note: 'GET /status-types']
  final_status_flg boolean
  synced_on        timestamptz
}

Table ref_product_class_types {
  class_type_code varchar [pk, note: 'GET /product-class-types']
  description     varchar
  synced_on       timestamptz
}

Table ref_origins {
  origin_code varchar [pk, note: 'GET /origins']
  description varchar
  synced_on   timestamptz
}

Table ref_grape_varietals {
  vartl_id   integer [pk, note: 'GET /grape-varietals']
  vartl_name varchar
  synced_on  timestamptz
}

Table ref_qualifications {
  ref_qualification_id integer [pk, note: 'GET /qualifications']
  long_desc            text
  synced_on            timestamptz
}

// receivedCode has no upstream endpoint; seeded from REF_RECEIVED_CODES_SEED.
Table ref_received_codes {
  received_code varchar [pk]
  description   varchar
}

// -----------------------------------------------------------------------------
// Pipeline state
// -----------------------------------------------------------------------------

Table pipeline_day_status {
  component     varchar     [note: 'list_ingest | detail_fill | image_ingest | image_analysis | image_embedding']
  business_date date
  status        varchar     [note: 'pending | in_progress | complete | gave_up']
  api_count     integer     [note: 'expected, from /colas/count or local colas']
  db_count      integer     [note: 'actual, measured after the run']
  attempt_count integer
  last_run_name varchar
  last_run_on   timestamptz [note: 'when this component last touched the day']
  last_error    text

  indexes {
    (component, business_date) [pk]
    (component, status, business_date)
  }

  Note: 'The pipeline\'s only position marker. A day is complete only when api_count equals db_count.'
}

Table schema_migrations {
  migration_id varchar [pk]
  checksum     varchar
  applied_on   timestamptz
  applied_by   varchar
}

// Materialised search surface, one row per COLA, maintained from vw_colas by
// search_materialize.py. ocr_text lives in cola_search_ocr so label text never
// bloats the hot row. Only the added/managed columns are listed; the rest mirror
// vw_colas one-for-one.
Table cola_search {
  cola_id                   bigint      [pk, note: 'from vw_colas [local]']
  completed_date            date        [note: 'mirrors colas.completed_date']
  brand_name                text        [note: 'mirrors colas.brand_name']
  fanciful_name             text        [note: 'mirrors colas.fanciful_name']
  applicant_name            text        [note: 'permit or submitter name [local]']
  ct_commodity              text        [note: 'wine | beer | distilled_spirits | unknown [local]']
  ct_source                 text        [note: 'domestic | import | unknown [local]']
  origin                    varchar     [note: 'mirrors colas origin label']
  status                    varchar     [note: 'mirrors colas.status']
  primary_permit_state_addr varchar     [note: 'primary permit state, indexed upper() [local]']
  serial_num                varchar     [note: 'id-ish, exact/prefix btree [local]']
  permit_num                varchar     [note: 'id-ish, exact/prefix btree [local]']
  primary_permit_id         varchar     [note: 'id-ish, exact/prefix btree [local]']
  submitter_id              varchar     [note: 'id-ish, exact/prefix btree [local]']
  permits                   jsonb       [note: 'rolled-up permits array [local]']
  search_tsv                tsvector    [note: 'generated: A brand/fanciful, B applicant/permit, C rest; GIN, websearch_to_tsquery [local]']
  _loaded_at                timestamptz [note: 'as-of time this row was materialised [local]']

  indexes {
    (completed_date, cola_id)                                     [note: 'DESC NULLS LAST, matches newest-first sort']
    (ct_commodity, completed_date, cola_id)                       [note: 'facet + newest-first']
    (ct_source, completed_date, cola_id)                          [note: 'facet + newest-first']
    (status, completed_date, cola_id)                             [note: 'facet + newest-first']
    (origin, completed_date, cola_id)                             [note: 'facet + newest-first']
    (brand_name, cola_id)
    (applicant_name, cola_id)
    `upper(primary_permit_state_addr)`
    serial_num [note: 'varchar_pattern_ops']
    permit_num [note: 'varchar_pattern_ops']
    primary_permit_id [note: 'varchar_pattern_ops']
    submitter_id [note: 'varchar_pattern_ops']
    brand_name [type: gin, note: 'pg_trgm']
    fanciful_name [type: gin, note: 'pg_trgm']
    applicant_name [type: gin, note: 'pg_trgm']
    permits [type: gin, note: 'jsonb_path_ops']
    search_tsv [type: gin]
  }

  Note: 'Physical copy of vw_colas for indexing. Only the pk, indexed and managed columns are listed; the rest mirror vw_colas one-for-one. Never written by hand.'
}

Table cola_search_ocr {
  cola_id    bigint      [pk]
  ocr_text   text        [note: 'concatenated label OCR [local]']
  ocr_tsv    tsvector    [note: 'generated tsvector over ocr_text, GIN [local]']
  _loaded_at timestamptz [note: 'as-of time this row was materialised [local]']

  indexes {
    ocr_tsv [type: gin]
  }
}

// Refresh queue for cola_search. AFTER-row triggers on colas and its child
// tables push changed cola_ids here; search_materialize.py drains it so the
// nightly job touches only what moved, regardless of which table changed.
Table cola_search_dirty {
  cola_id   bigint      [pk, note: 'COLA awaiting (re)materialisation [local]']
  marked_at timestamptz [note: 'when it was queued; drained oldest-first [local]']

  indexes {
    (marked_at, cola_id)
  }
}

// Pipeline coverage by calendar year of colas.completed_date, rebuilt whole by
// search_materialize.py on every run. A COLA counts towards an enrichment stage
// only when every one of its stored images (SUCCESS with a blob) is done.
Table cola_coverage_year {
  coverage_year        integer     [pk, note: 'calendar year of completed_date [local]']
  api_cola_count       bigint      [note: 'sum of pipeline_day_status.api_count for list_ingest; upstream truth, nullable [local]']
  ingested_cola_count  bigint      [note: 'colas rows [local]']
  detail_cola_count    bigint      [note: 'colas with detail_scraped_on [local]']
  image_cola_count     bigint      [note: 'colas with >= 1 stored image [local]']
  ocr_cola_count       bigint      [note: 'colas whose every stored image has a terminal analysis [local]']
  embedding_cola_count bigint      [note: 'colas whose every stored image has an image_feature_vector [local]']
  _loaded_at           timestamptz [note: 'as-of time this row was materialised [local]']
}

Ref: cola_images.cola_id > colas.cola_id
Ref: cola_image_analysis.(cola_id, file_name) > cola_images.(cola_id, file_name)
Ref: image_analysis_items.(cola_id, file_name, analysis_model) > cola_image_analysis.(cola_id, file_name, analysis_model)
Ref: api_usage.cola_id > colas.cola_id
Ref: cola_permits.cola_id > colas.cola_id
Ref: cola_submitters.cola_id - colas.cola_id
Ref: cola_qualifications.cola_id > colas.cola_id
Ref: cola_grape_varietals.cola_id > colas.cola_id
Ref: cola_search.cola_id - colas.cola_id
Ref: cola_search_ocr.cola_id - cola_search.cola_id
Ref: cola_search_dirty.cola_id > colas.cola_id

Ref: colas.status_code > ref_status_types.status_code
Ref: colas.class_type_code > ref_product_class_types.class_type_code
Ref: colas.origin_code > ref_origins.origin_code
Ref: colas.received_code > ref_received_codes.received_code
Ref: cola_grape_varietals.vartl_id > ref_grape_varietals.vartl_id
Ref: cola_qualifications.ref_qualification_id > ref_qualifications.ref_qualification_id
